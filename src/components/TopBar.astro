---
import { nav, site } from '../data/site';
---
<header class="topbar">
  <div class="topbar__inner">
    <a class="topbar__brand" href="#top" aria-label={`${site.name} 首页`}>
      <span class="topbar__mark" aria-hidden="true"></span>
      <span class="topbar__name">{site.name}</span>
      <span class="topbar__sub">的小窝</span>
    </a>

    <nav class="topbar__nav" aria-label="页面导航">
      {
        nav.map((item) =>
          item.panel ? (
            <button class="topbar__nav-btn" type="button" data-open-panel={item.panel}>{item.label}</button>
          ) : (
            <a href={`#${item.id}`} data-nav-link={item.id}>{item.label}</a>
          )
        )
      }
    </nav>

    <div class="topbar__actions">
      <button class="replay-btn" type="button" data-replay-intro aria-label="重看开场">重看开场</button>
    </div>
  </div>
</header>
