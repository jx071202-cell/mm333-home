---
import { nav, site } from '../data/site';
---
<header class="topbar">
  <div class="topbar__inner">
    <a class="topbar__brand" href="#top" aria-label={`${site.name} 首页`}>
      <span class="topbar__mark" aria-hidden="true"></span>
      <span class="topbar__name">{site.name}</span>
      <span class="topbar__sub">的小窝</span>
    </a>

    <nav class="topbar__nav" aria-label="页面导航">
      {nav.map((item) => <a href={`#${item.id}`} data-nav-link={item.id}>{item.label}</a>)}
    </nav>

    <div class="topbar__actions">
      <button class="theme-btn" type="button" data-theme-toggle aria-label="切换黄昏 / 夜">
        <svg class="theme-btn__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5 5l1.4 1.4M17.6 17.6L19 19M19 5l-1.4 1.4M6.4 17.6L5 19" stroke-linecap="round" />
        </svg>
        <svg class="theme-btn__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="replay-btn" type="button" data-replay-intro aria-label="重看开场">重看开场</button>
    </div>
  </div>
</header>
