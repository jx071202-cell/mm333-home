---
import { intro } from '../data/site';
import { withBase } from '../lib/paths';
---
<div
  class="gate gate--clean"
  data-gate
  data-video-wide={withBase(intro.videoWide)}
  data-video-small={withBase(intro.videoSmall)}
  aria-label="开场视频，点击进入"
>
  <video
    class="gate__video"
    data-gate-video
    muted
    playsinline
    preload="auto"
    poster={withBase(intro.poster)}
    aria-hidden="true"
  ></video>
  <div class="gate__veil" aria-hidden="true"></div>
</div>
