---
import { scene } from '../data/site';
import { withBase } from '../lib/paths';
---
<section class="stage" data-stage id="top">
  <div class="stage__bg" aria-hidden="true">
    <picture>
      <source media="(min-width: 900px)" srcset={withBase(scene.artWide)} />
      <source media="(max-width: 899px)" srcset={withBase(scene.artTall)} />
      <img
        class="stage__art"
        data-art
        src={withBase(scene.art)}
        alt=""
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </div>
  <canvas class="stage__rain" data-rain aria-hidden="true"></canvas>
  <div class="stage__scrim" aria-hidden="true"></div>

  <div class="stage__inner wrap">
    <p class="stage__kicker">{scene.kicker}</p>
    <h1 class="stage__title">{scene.title}</h1>
    <p class="stage__lines">
      {scene.lines.map((line) => <span>{line}</span>)}
    </p>
    <p class="stage__hint">
      <span class="stage__dot" aria-hidden="true"></span>
      {scene.hint}
    </p>
  </div>

  <p class="stage__credit">{scene.credit}</p>
  <p class="stage__scroll" aria-hidden="true"><span></span>SCROLL</p>
</section>
