---
const palette = [202, 330, 282, 45, 150, 18, 262, 190, 320, 95, 220, 350];

const LEN = 46;
const SIZE = 30;
const SHAPE = 'drop';

const items = Array.from({ length: 12 }, (_, i) => ({
  left: `${2.2 + i * 7.9}%`,
  hue: palette[i % palette.length],
  len: LEN,
  size: SIZE,
  shape: SHAPE,
  note: 96 + (i % 6) * 2,
  delay: `${(i * 0.47).toFixed(2)}s`,
  dur: '6.2s',
}));
---
<div class="chimes" aria-hidden="true">
  {
    items.map((item) => (
      <div
        class="chime"
        data-chime
        data-note={item.note}
        style={`--left:${item.left};--hue:${item.hue};--len:${item.len}px;--size:${item.size}px;--delay:${item.delay};--dur:${item.dur}`}
      >
        <span class="chime__thread"></span>
        <span class="chime__beads"><i></i><i></i><i></i></span>
        <span class="chime__pendant">
          <svg viewBox="0 0 40 48">
            <path d="M20 3c8 10 14 17 14 26a14 14 0 0 1-28 0C6 20 12 13 20 3Z" />
            <path class="chime__shine" d="M14 20c2-4 6-6 9-5" />
          </svg>
        </span>
      </div>
    ))
  }
</div>
