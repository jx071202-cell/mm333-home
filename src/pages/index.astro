---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero, playlist } from '../data/site';
import WindChimes from '../components/WindChimes.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout>
  <section class="hero hero--center" id="top">
    <WindChimes />
    <div class="side-art side-art--left" aria-hidden="true">
      <img src={withBase('/images/side-left.jpg')} alt="" loading="lazy" />
      <img src={withBase('/images/side-right.jpg')} alt="" loading="lazy" />
    </div>
    <div class="side-art side-art--right" aria-hidden="true">
      <img src={withBase('/images/side-third.jpg')} alt="" loading="lazy" />
      <img src={withBase('/images/side-fourth.jpg')} alt="" loading="lazy" />
    </div>
    <div class="hero__center">
      <img class="hero__avatar" src={hero.avatar} alt="mm333 的头像" />
      <p class="hero__greeting">{hero.greeting}</p>
      <h1 class="hero__title">{hero.title}<span>{hero.suffix}</span></h1>
      <p class="hero__sub">{hero.sub}</p>
      <div class="hero__socials">
        {
          hero.socials.map((item) => (
            <a class="hero__social" href={item.href} target="_blank" rel="noopener">{item.label}</a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="playlist-pop" data-playlist-pop aria-hidden="true">
    <div class="playlist-pop__inner">
      <button class="playlist-pop__close" type="button" data-close-playlist aria-label="关闭列表">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" /></svg>
      </button>
      <p class="playlist-pop__title">播放列表</p>
      <ul class="playlist">
        {
          playlist.songs.map((song, index) => (
            <li class="playlist__item" data-song data-index={index} data-id={song.id} data-cover={song.cover}>
              <button type="button" class="playlist__button" data-play-song={index}>
                <span class="playlist__idx">{String(index + 1).padStart(2, '0')}</span>
                <span class="playlist__body">
                  <span class="playlist__name">{song.name}</span>
                  <span class="playlist__meta">{song.artist} · {song.album}</span>
                </span>
                <span class="playlist__state" data-state aria-hidden="true">▶</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="player-bar" data-player>
    <button class="player-bar__cover" type="button" data-folia-open aria-label="展开歌词">
      <img data-player-cover alt="" src={playlist.songs[0].cover} width="56" height="56" />
    </button>

    <div class="player-bar__meta">
      <span class="player__title" data-player-title>{playlist.songs[0].name}</span>
      <span class="player__sub" data-player-sub>{playlist.songs[0].artist} · {playlist.songs[0].album}</span>
    </div>

    <div class="player-bar__controls">
      <button class="player__btn" type="button" data-play-prev aria-label="上一首">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 5v14M18 5l-9 7 9 7V5Z" stroke-linejoin="round" /></svg>
      </button>
      <button class="player__btn player__btn--main" type="button" data-play-toggle aria-label="播放">
        <svg class="player__icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7L8 5Z" /></svg>
        <svg class="player__icon-pause" viewBox="0 0 24 24" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
      </button>
      <button class="player__btn" type="button" data-play-next aria-label="下一首">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 5v14M6 5l9 7-9 7V5Z" stroke-linejoin="round" /></svg>
      </button>
    </div>

    <div class="player-bar__progress">
      <span class="player__time" data-time-current>0:00</span>
      <div class="player__bar" data-seek>
        <span class="player__fill" data-progress></span>
      </div>
      <span class="player__time" data-time-total>0:00</span>
    </div>

    <button class="player-bar__icon" type="button" data-player-mute aria-label="静音">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 9v6h4l5 4V5L9 9H5Z" stroke-linejoin="round" /><path d="M16.5 8.5a5 5 0 0 1 0 7" stroke-linecap="round" /></svg>
    </button>

    <button class="player-bar__icon" type="button" data-folia-open aria-label="歌词">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 7h14M5 12h9M5 17h6" stroke-linecap="round" /></svg>
    </button>

    <button class="player-bar__list" type="button" data-toggle-playlist aria-label="播放列表">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h11M4 18h7" stroke-linecap="round" /></svg>
    </button>

    <audio data-audio preload="none"></audio>
  </div>

  <div class="folia" data-folia aria-hidden="true">
    <div class="folia__bg" data-folia-bg aria-hidden="true"></div>
    <div class="folia__scrim" aria-hidden="true"></div>

    <button class="folia__close" type="button" data-folia-close aria-label="收起歌词">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" /></svg>
    </button>

    <div class="folia__body">
      <img class="folia__cover" data-folia-cover alt="" src={playlist.songs[0].cover} />
      <p class="folia__title" data-folia-title>{playlist.songs[0].name}</p>
      <p class="folia__sub" data-folia-sub>{playlist.songs[0].artist} · {playlist.songs[0].album}</p>
      <div class="folia__lyrics" data-folia-lyrics>
        <p class="folia__line is-active">点一首歌，开始看歌词</p>
      </div>
    </div>
  </div>

</BaseLayout>
