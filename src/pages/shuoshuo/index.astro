---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { github } from '../../data/site';

const writeUrl = `https://github.com/${github.repo}/issues/new`;
---
<BaseLayout title="说说">
  <section class="shuo-page">
    <div class="shuo-page__inner">
      <header class="shuo-page__head">
        <p class="shuo-page__kicker">DAILY NOTES</p>
        <h1 class="shuo-page__title">说说</h1>
        <p class="shuo-page__sub">每天的一点小事，想到就写。</p>
      </header>

      <form class="shuo-editor" data-shuo-editor>
        <input class="shuo-editor__title" data-shuo-title maxlength="80" placeholder="标题（可不填）" />
        <textarea class="shuo-editor__text" data-shuo-text rows="4" placeholder="今天发生的小事…支持换行、**加粗**、[链接](url)"></textarea>
        <div class="shuo-editor__row">
          <button class="shuo-editor__publish" type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12 20 4l-6 16-3-7-7-1Z" stroke-linejoin="round" /></svg>
            发布
          </button>
          <button class="shuo-editor__ghost" type="button" data-shuo-settings aria-expanded="false">连接 GitHub</button>
          <span class="shuo-editor__status" data-shuo-status></span>
        </div>

        <div class="shuo-token" data-shuo-token hidden>
          <p class="shuo-token__hint">
            想让大家（和别的设备）都能看到，就填一个 GitHub token：<br />
            打开 <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">新建 token</a>，
            只选 <strong>Issues: Read and write</strong>，仓库选 <code>{github.repo}</code>，把 <code>github_pat_...</code> 粘进来。
            <br />不填也行：内容只保存在这台设备的浏览器里。
          </p>
          <div class="shuo-token__row">
            <input class="shuo-token__input" data-shuo-token-input type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_..." />
            <button class="shuo-editor__ghost" type="button" data-shuo-token-save>保存</button>
            <button class="shuo-editor__ghost" type="button" data-shuo-token-clear>清除</button>
          </div>
        </div>
      </form>

      <div class="shuo-feed" data-shuo-feed data-repo={github.repo}>
        <p class="shuo-feed__status" data-shuo-status-feed>正在加载…</p>
      </div>

      <p class="shuo-page__tip">
        没有连接 GitHub 时，发布的内容只存在这台浏览器里；
        <a href={writeUrl} target="_blank" rel="noopener">也可以去 GitHub 写</a>。
      </p>
    </div>
  </section>

  <script>
    const feed = document.querySelector('[data-shuo-feed]');
    const form = document.querySelector('[data-shuo-editor]');
    if (feed && form) {
      const repo = feed.dataset.repo;
      const statusEl = form.querySelector('[data-shuo-status]');
      const feedStatus = feed.querySelector('[data-shuo-status-feed]');
      const titleInput = form.querySelector('[data-shuo-title]');
      const textInput = form.querySelector('[data-shuo-text]');
      const tokenPanel = form.querySelector('[data-shuo-token]');
      const tokenInput = form.querySelector('[data-shuo-token-input]');
      const settingsBtn = form.querySelector('[data-shuo-settings]');
      const tokenSave = form.querySelector('[data-shuo-token-save]');
      const tokenClear = form.querySelector('[data-shuo-token-clear]');

      const LOCAL_KEY = 'mm333-shuo-local';
      const TOKEN_KEY = 'mm333-shuo-token';

      const readLocal = () => {
        try {
          const raw = window.localStorage.getItem(LOCAL_KEY);
          const list = raw ? JSON.parse(raw) : [];
          return Array.isArray(list) ? list : [];
        } catch (e) {
          return [];
        }
      };

      const writeLocal = (list) => {
        try {
          window.localStorage.setItem(LOCAL_KEY, JSON.stringify(list));
        } catch (e) {}
      };

      const readToken = () => {
        try {
          return window.localStorage.getItem(TOKEN_KEY) || '';
        } catch (e) {
          return '';
        }
      };

      const escapeHtml = (value) =>
        String(value).replace(/[&<>"']/g, (ch) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[ch]);

      const renderBody = (markdown) => {
        let html = escapeHtml(markdown);
        html = html.replace(/!\[([^\]]*)\]\((https?:\/\/[^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy" />');
        html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
        html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
        return html
          .split(/\n{2,}/)
          .map((block) => `<p>${block.replace(/\n/g, '<br />')}</p>`)
          .join('');
      };

      const formatDate = (value) => {
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return '';
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        const h = String(d.getHours()).padStart(2, '0');
        const min = String(d.getMinutes()).padStart(2, '0');
        return `${y}.${m}.${day} ${h}:${min}`;
      };

      const entryHtml = (entry, options = {}) => {
        const title = entry.title ? `<span class="shuo-entry__title">${escapeHtml(entry.title)}</span>` : '';
        const badge = options.local ? '<span class="shuo-entry__badge">本地</span>' : '';
        const del = options.local
          ? `<button class="shuo-entry__delete" type="button" data-delete-entry="${escapeHtml(entry.id)}" aria-label="删除这条">×</button>`
          : '';
        return `
          <article class="shuo-entry">
            <div class="shuo-entry__head">
              <time class="shuo-entry__date">${formatDate(entry.created_at)}</time>
              ${title}${badge}${del}
            </div>
            <div class="shuo-entry__body">${renderBody(entry.body || '')}</div>
          </article>
        `;
      };

      let remoteEntries = [];

      const render = () => {
        const local = readLocal();
        const all = [
          ...local.map((item) => ({ ...item, __local: true })),
          ...remoteEntries,
        ].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));

        if (!all.length) {
          if (feedStatus) feedStatus.textContent = '还没有说说，写下今天的第一条吧。';
          feed.querySelectorAll('.shuo-list').forEach((el) => el.remove());
          return;
        }
        if (feedStatus) feedStatus.remove();
        const list = document.createElement('div');
        list.className = 'shuo-list';
        list.innerHTML = all.map((item) => entryHtml(item, { local: item.__local })).join('');
        feed.querySelectorAll('.shuo-list').forEach((el) => el.remove());
        feed.appendChild(list);
      };

      const setStatus = (text, tone = '') => {
        if (!statusEl) return;
        statusEl.textContent = text;
        statusEl.dataset.tone = tone;
      };

      const createIssue = async (title, body, token) => {
        const response = await fetch(`https://api.github.com/repos/${repo}/issues`, {
          method: 'POST',
          headers: {
            Accept: 'application/vnd.github+json',
            Authorization: `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ title, body }),
        });
        if (!response.ok) {
          const detail = await response.json().catch(() => ({}));
          throw new Error(detail.message || `HTTP ${response.status}`);
        }
        return response.json();
      };

      const loadRemote = async () => {
        try {
          const response = await fetch(`https://api.github.com/repos/${repo}/issues?state=all&per_page=50`, {
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!response.ok) throw new Error(String(response.status));
          const issues = await response.json();
          remoteEntries = issues.filter((issue) => !issue.pull_request);
        } catch (e) {
          remoteEntries = [];
        }
        render();
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = textInput.value.trim();
        if (!body) {
          setStatus('还没写内容', 'warn');
          textInput.focus();
          return;
        }
        const title = titleInput.value.trim() || formatDate(new Date());
        const token = readToken();
        setStatus(token ? '正在发布…' : '正在保存…');

        if (token) {
          try {
            const issue = await createIssue(title, body, token);
            remoteEntries.unshift(issue);
            textInput.value = '';
            titleInput.value = '';
            render();
            setStatus('已发布 ✓', 'ok');
            return;
          } catch (error) {
            setStatus(`发布失败：${error.message}`, 'warn');
            return;
          }
        }

        const local = readLocal();
        local.unshift({
          id: `local-${Date.now()}`,
          title: titleInput.value.trim(),
          body,
          created_at: new Date().toISOString(),
        });
        writeLocal(local);
        textInput.value = '';
        titleInput.value = '';
        render();
        setStatus('已保存在本机浏览器', 'ok');
      });

      feed.addEventListener('click', (event) => {
        const button = event.target.closest('[data-delete-entry]');
        if (!button) return;
        const id = button.getAttribute('data-delete-entry');
        writeLocal(readLocal().filter((item) => item.id !== id));
        render();
        setStatus('已删除', 'ok');
      });

      const syncTokenUi = () => {
        const token = readToken();
        settingsBtn?.setAttribute('aria-expanded', String(Boolean(token)));
        settingsBtn?.classList.toggle('is-connected', Boolean(token));
        if (settingsBtn) settingsBtn.textContent = token ? '已连接 GitHub' : '连接 GitHub';
      };

      settingsBtn?.addEventListener('click', () => {
        tokenPanel.hidden = !tokenPanel.hidden;
      });

      tokenSave?.addEventListener('click', () => {
        const value = tokenInput.value.trim();
        try {
          if (value) window.localStorage.setItem(TOKEN_KEY, value);
          else window.localStorage.removeItem(TOKEN_KEY);
        } catch (e) {}
        tokenInput.value = '';
        tokenPanel.hidden = true;
        syncTokenUi();
        setStatus(value ? '已连接 GitHub，之后发布直接同步' : '已清除 token', 'ok');
      });

      tokenClear?.addEventListener('click', () => {
        try {
          window.localStorage.removeItem(TOKEN_KEY);
        } catch (e) {}
        syncTokenUi();
        setStatus('已清除 token', 'ok');
      });

      syncTokenUi();
      loadRemote();
    }
  </script>
</BaseLayout>
