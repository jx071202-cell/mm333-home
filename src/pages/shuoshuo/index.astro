---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { github, shuoshuo } from '../../data/site';

const writeUrl = `https://github.com/${github.repo}/issues/new`;
---
<BaseLayout title="说说">
  <section class="shuo-page">
    <div class="shuo-page__inner">
      <header class="shuo-page__head">
        <p class="shuo-page__kicker">DAILY NOTES</p>
        <h1 class="shuo-page__title">说说</h1>
        <p class="shuo-page__sub">每天的一点小事，想到就写。</p>
        <a class="shuo-page__write" href={writeUrl} target="_blank" rel="noopener">
          写一条
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round" /></svg>
        </a>
      </header>

      <div
        class="shuo-feed"
        data-shuo-feed
        data-repo={github.repo}
        data-fallback={JSON.stringify(shuoshuo)}
      >
        <p class="shuo-feed__status" data-shuo-status>正在加载…</p>
      </div>

      <p class="shuo-page__tip">写一条 = 在 GitHub 上新建一个 issue，内容会马上出现在这里（不需要重新部署）。</p>
    </div>
  </section>

  <script>
    const feed = document.querySelector('[data-shuo-feed]');
    if (feed) {
      const status = feed.querySelector('[data-shuo-status]');
      const repo = feed.dataset.repo;
      let fallback = [];
      try {
        fallback = JSON.parse(feed.dataset.fallback || '[]');
      } catch (e) {
        fallback = [];
      }

      const escapeHtml = (value) =>
        String(value).replace(/[&<>"']/g, (ch) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[ch]);

      const renderBody = (markdown) => {
        let html = escapeHtml(markdown);
        html = html.replace(/!\[([^\]]*)\]\((https?:\/\/[^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy" />');
        html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
        html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
        html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
        const blocks = html
          .split(/\n{2,}/)
          .map((block) => `<p>${block.replace(/\n/g, '<br />')}</p>`)
          .join('');
        return blocks;
      };

      const formatDate = (iso) => {
        const d = new Date(iso);
        if (Number.isNaN(d.getTime())) return '';
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}.${m}.${day}`;
      };

      const render = (entries) => {
        if (!entries.length) {
          if (status) status.textContent = '还没有说说，点「写一条」开始记录吧。';
          return;
        }
        if (status) status.remove();
        const list = document.createElement('div');
        list.className = 'shuo-list';
        entries.forEach((entry) => {
          const item = document.createElement('article');
          item.className = 'shuo-entry';
          const title = entry.title ? `<span class="shuo-entry__title">${escapeHtml(entry.title)}</span>` : '';
          item.innerHTML = `
            <div class="shuo-entry__head">
              <time class="shuo-entry__date">${formatDate(entry.created_at)}</time>
              ${title}
            </div>
            <div class="shuo-entry__body">${renderBody(entry.body || '')}</div>
          `;
          list.appendChild(item);
        });
        feed.appendChild(list);
      };

      const load = async () => {
        try {
          const response = await fetch(
            `https://api.github.com/repos/${repo}/issues?state=all&per_page=50`,
            { headers: { Accept: 'application/vnd.github+json' } }
          );
          if (!response.ok) throw new Error(String(response.status));
          const issues = await response.json();
          const entries = issues.filter((issue) => !issue.pull_request);
          if (!entries.length) throw new Error('empty');
          render(entries);
        } catch (e) {
          if (fallback.length) {
            render(
              fallback.map((item) => ({
                title: '',
                body: item.text,
                created_at: item.date,
              }))
            );
            return;
          }
          if (status) status.textContent = '暂时读不到说说，稍后再来看看。';
        }
      };

      load();
    }
  </script>
</BaseLayout>
